# =====================================================================
# AG-PROJ05 — Delivery System
# Monorepo: Python Django backend + Native Android app
# Patterns are unanchored so they apply in any sub-folder
# (e.g. backend/, android/).
# =====================================================================


# =====================================================================
# SECRETS & CREDENTIALS — NEVER COMMIT
# =====================================================================
.env
.env.*
!.env.example
local_settings.py
settings_local.py

# Firebase / Google service accounts
firebase-service-account*.json
*service-account*.json
google-services.json
GoogleService-Info.plist

# Android signing
*.jks
*.keystore
keystore.properties
signing.properties

# Generic key material
*.pem
*.key
*.p12


# =====================================================================
# PYTHON / DJANGO
# =====================================================================
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Packaging
*.egg-info/
.eggs/
pip-wheel-metadata/
dist/

# Databases (local dev)
*.sqlite3
*.sqlite3-journal
db.sqlite3*

# Uploaded media, collected static, DB backups
media/
staticfiles/
backups/

# Django / Celery runtime
*.pot
celerybeat-schedule*
celerybeat.pid

# Tests, coverage & tooling caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pyre/


# =====================================================================
# ANDROID / GRADLE / KOTLIN
# =====================================================================
.gradle/
build/
.kotlin/
gradle-app.setting
.gradletasknamecache
local.properties

# Build outputs
*.apk
*.aab
*.aar
*.ap_
*.dex
*.class
bin/
gen/
out/
**/app/release/
captures/

# Native build
.externalNativeBuild/
.cxx/

# Android Studio / IntelliJ
*.iml
.idea/
.navigation/
*.hprof

# Play Store listing assets (kept local)
play_assets/


# =====================================================================
# DOCS (kept local — same convention as AG-PROJ01 / AG-PROJ04)
# =====================================================================
docs/


# =====================================================================
# NODE (if any frontend tooling is added later)
# =====================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/


# =====================================================================
# EDITORS, AI TOOLING & OS
# =====================================================================
.vscode/
*.sublime-project
*.sublime-workspace
.claude/settings.local.json

.DS_Store
Thumbs.db
desktop.ini

*.log
*~
*.swp
*.bak
*.tmp
