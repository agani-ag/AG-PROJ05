# =====================================================================
# AG-PROJ05 — Delivery System
# Monorepo: Python Django backend + Flutter mobile app
# (Android first, iOS later)
# Patterns are unanchored so they apply in any sub-folder
# (e.g. backend/, mobile/).
# =====================================================================


# =====================================================================
# SECRETS & CREDENTIALS — NEVER COMMIT
# =====================================================================
.env
.env.*
!.env.example
local_settings.py
settings_local.py

# Firebase / Google service accounts
firebase-service-account*.json
*service-account*.json
google-services.json
GoogleService-Info.plist

# Android signing (keystore.properties = AG-PROJ04 style,
# key.properties = Flutter convention)
*.jks
*.keystore
keystore.properties
key.properties
signing.properties

# Apple signing & push keys (iOS)
*.p8
*.mobileprovision
*.cer

# FlutterFire generated config (same policy as google-services.json)
firebase_options.dart

# Generic key material
*.pem
*.key
*.p12


# =====================================================================
# PYTHON / DJANGO
# =====================================================================
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Packaging
*.egg-info/
.eggs/
pip-wheel-metadata/
dist/

# Databases (local dev)
*.sqlite3
*.sqlite3-journal
db.sqlite3*

# Uploaded media, collected static, DB backups
media/
staticfiles/
backups/

# Django / Celery runtime
*.pot
celerybeat-schedule*
celerybeat.pid

# Tests, coverage & tooling caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pyre/


# =====================================================================
# FLUTTER / DART
# (flutter create also adds nested .gitignore files; these are a safety
#  net. pubspec.lock and .metadata are intentionally TRACKED.)
# =====================================================================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
.fvm/
coverage/
**/doc/api/
app.*.symbols
app.*.map.json
**/android/app/debug/
**/android/app/profile/


# =====================================================================
# iOS / XCODE (Flutter ios/ folder) — scoped to avoid matching
# app source folders such as lib/features/profile/
# =====================================================================
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/Runner/GeneratedPluginRegistrant.*
**/ios/ServiceDefinitions.json
**/ios/**/profile
**/.generated/
DerivedData/
xcuserdata/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.moved-aside
**/dgph


# =====================================================================
# ANDROID / GRADLE / KOTLIN
# =====================================================================
.gradle/
build/
.kotlin/
gradle-app.setting
.gradletasknamecache
local.properties

# Build outputs
*.apk
*.aab
*.aar
*.ap_
*.dex
*.class
bin/
gen/
out/
**/app/release/
captures/

# Native build
.externalNativeBuild/
.cxx/

# Android Studio / IntelliJ
*.iml
.idea/
.navigation/
*.hprof

# Play Store listing assets (kept local)
play_assets/


# =====================================================================
# DOCS (kept local — same convention as AG-PROJ01 / AG-PROJ04)
# =====================================================================
docs/


# =====================================================================
# NODE (if any frontend tooling is added later)
# =====================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/


# =====================================================================
# EDITORS, AI TOOLING & OS
# =====================================================================
.vscode/
*.sublime-project
*.sublime-workspace
.claude/settings.local.json

.DS_Store
Thumbs.db
desktop.ini

*.log
*~
*.swp
*.bak
*.tmp
